# Copy to `.env` or export before running the API. Do not commit `.env`.
# Compose reads this file automatically.
#
# DATABASE_URL here is for Gradle/IDE on the host (localhost).
# Inside Compose the api service always uses jdbc:postgresql://postgres:5432/autorepairshop.
DATABASE_URL=jdbc:postgresql://localhost:5432/autorepairshop
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
# HS256 requires at least 32 bytes (32 ASCII characters). Generate for anything beyond local Docker:
#   openssl rand -base64 48
JWT_SECRET=change-me-to-a-32-byte-or-longer-secret-key
JWT_TTL_SECONDS=86400
REFRESH_TTL_SECONDS=1209600
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=oficina@localhost
INVITE_BASE_URL=http://localhost:8080/invite
# MAIL_USERNAME / MAIL_PASSWORD are unused with Mailpit. Set them only for an authenticated SMTP server.
