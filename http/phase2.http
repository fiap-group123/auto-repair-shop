@baseUrl = http://localhost:8080
@notificationToken = local-budget-notification-token

# Abertura da OS com cliente, veiculo, servicos e pecas, consulta de status,
# fila de trabalho e notificacao externa de orcamento.
# O estoque da peca precisa existir antes. Rode de cima para baixo.

###
# 1. Login — gerente
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "gerente@oficina.com",
  "password": "senha123"
}

> {%
client.global.set("managerToken", response.body.accessToken);
%}

###
# 2. Cadastrar peca no estoque
POST {{baseUrl}}/inventories
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{
  "name": "Filtro de oleo fase 2",
  "kind": "PART",
  "unitPrice": 45.00,
  "stock": 10
}

> {% client.global.set("inventoryId", response.body.id); %}

###
# 3. Abrir OS com cliente, veiculo, servico e peca
POST {{baseUrl}}/service-orders
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{
  "customer": {
    "documentId": "111.444.777-35",
    "name": "Ana Souza",
    "email": "ana.souza@email.com",
    "phone": "11988887777"
  },
  "vehicle": {
    "plate": "BRA2E19",
    "brand": "Honda",
    "model": "Civic",
    "year": 2022,
    "color": "Prata"
  },
  "services": [
    { "name": "Troca de oleo", "basePrice": 150.00 }
  ],
  "parts": [
    { "inventoryId": "{{inventoryId}}", "quantity": 1 }
  ]
}

> {% client.global.set("serviceOrderId", response.body.id); %}

###
# 4. Consultar status
GET {{baseUrl}}/service-orders/{{serviceOrderId}}/status
Authorization: Bearer {{managerToken}}

###
# 5. Fila de trabalho (sem finalizadas e entregues)
GET {{baseUrl}}/service-orders
Authorization: Bearer {{managerToken}}

###
# 6. Iniciar diagnostico
POST {{baseUrl}}/service-orders/{{serviceOrderId}}/diagnosis
Authorization: Bearer {{managerToken}}

###
# 7. Encerrar diagnostico (orcamento aguardando aprovacao)
POST {{baseUrl}}/service-orders/{{serviceOrderId}}/diagnosis/finish
Authorization: Bearer {{managerToken}}

###
# 8. Notificacao externa — aprovar orcamento
POST {{baseUrl}}/integrations/budget-decisions
X-Notification-Token: {{notificationToken}}
Content-Type: application/json

{
  "serviceOrderId": "{{serviceOrderId}}",
  "decision": "APPROVED"
}

###
# 9. Status depois da aprovacao
GET {{baseUrl}}/service-orders/{{serviceOrderId}}/status
Authorization: Bearer {{managerToken}}
