@baseUrl = http://localhost:8080

# Fluxo linear de autenticacao. Rode de cima para baixo.
# Proximo arquivo: http/customer.http
# Convite: depois do POST /invite/customer, abra http://localhost:8025, copie o token e cole nos dois requests de /invite/{token}.

###
# 1. Primeiro usuario com papel errado — espera 422 (somente banco vazio)
POST {{baseUrl}}/auth/users
Content-Type: application/json

{
  "email": "primeiro@oficina.com",
  "password": "senha123",
  "role": "RECEPTIONIST"
}

###
# 2. Cadastro — primeiro usuario MANAGER
POST {{baseUrl}}/auth/users
Content-Type: application/json

{
  "email": "gerente@oficina.com",
  "password": "senha123",
  "role": "MANAGER"
}

###
# 3. Login — gerente
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "gerente@oficina.com",
  "password": "senha123"
}

> {%
client.global.set("managerToken", response.body.accessToken);
client.global.set("managerRefresh", response.body.refreshToken);
%}

###
# 4. Renovar access token
POST {{baseUrl}}/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{managerRefresh}}"
}

> {%
client.global.set("managerToken", response.body.accessToken);
client.global.set("managerRefresh", response.body.refreshToken);
%}

###
# 5. Cadastro — recepcionista
POST {{baseUrl}}/auth/users
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{
  "email": "recepcao@oficina.com",
  "password": "senha123",
  "role": "RECEPTIONIST"
}

###
# 6. Cadastro — mecanico
POST {{baseUrl}}/auth/users
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{
  "email": "mecanico@oficina.com",
  "password": "senha123",
  "role": "MECHANIC"
}

###
# 7. Cadastro — cliente John Doe (convite vai para o Mailpit)
POST {{baseUrl}}/customers
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{
  "documentId": "529.982.247-25",
  "name": "John Doe",
  "email": "john.doe@email.com",
  "phone": "11987654321"
}

###
# 8. Carregar customerId do John Doe
GET {{baseUrl}}/customers/document/52998224725
Authorization: Bearer {{managerToken}}

> {%
client.global.set("customerId", response.body.id);
client.global.set("document", response.body.documentId);
%}

###
# 9. Reenviar convite de login
POST {{baseUrl}}/invite/customer/{{customerId}}
Authorization: Bearer {{managerToken}}

###
# 10. Preview do convite — cole o token do Mailpit (http://localhost:8025)
GET {{baseUrl}}/invite/j5YYcFfGEA5EOYq0JSn45zwESeLKnHeTnyhKi2Dtdnw

###
# 11. Cliente cria login a partir do convite — mesmo token
POST {{baseUrl}}/invite/j5YYcFfGEA5EOYq0JSn45zwESeLKnHeTnyhKi2Dtdnw
Content-Type: application/json

{
  "email": "john.doe@email.com",
  "password": "senha123"
}

###
# 12. Login — recepcionista
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "recepcao@oficina.com",
  "password": "senha123"
}

> {%
client.global.set("receptionistToken", response.body.accessToken);
client.global.set("receptionistRefresh", response.body.refreshToken);
%}

###
# 13. Login — mecanico
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "mecanico@oficina.com",
  "password": "senha123"
}

> {%
client.global.set("mechanicToken", response.body.accessToken);
client.global.set("mechanicRefresh", response.body.refreshToken);
%}

###
# 14. Login — cliente (depois do passo 11)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "john.doe@email.com",
  "password": "senha123"
}

> {% client.global.set("clientToken", response.body.accessToken); %}

###
# 15. Logout — mecanico (nao mexe no token do gerente)
POST {{baseUrl}}/auth/logout
Content-Type: application/json

{
  "refreshToken": "{{mechanicRefresh}}"
}

###
# --- Erros (nao quebram o restante do fluxo) ---

###
# Cadastro sem token depois do bootstrap — espera 401
POST {{baseUrl}}/auth/users
Content-Type: application/json

{
  "email": "sem.token@oficina.com",
  "password": "senha123",
  "role": "RECEPTIONIST"
}

###
# E-mail duplicado — espera 409
POST {{baseUrl}}/auth/users
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{
  "email": "gerente@oficina.com",
  "password": "senha123",
  "role": "MANAGER"
}

###
# Credenciais invalidas — espera 401
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "gerente@oficina.com",
  "password": "errada"
}

###
# E-mail invalido — espera 422
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "nao-eh-email",
  "password": "senha123"
}

###
# Papel desconhecido — espera 422
POST {{baseUrl}}/auth/users
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{
  "email": "desconhecido@oficina.com",
  "password": "senha123",
  "role": "ADMIN"
}

###
# CLIENT pelo POST /auth/users — espera 422
POST {{baseUrl}}/auth/users
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{
  "email": "cliente.sem.vinculo@oficina.com",
  "password": "senha123",
  "role": "CLIENT"
}

###
# Staff com customerId — espera 422
POST {{baseUrl}}/auth/users
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{
  "email": "mecanico.vinculado@oficina.com",
  "password": "senha123",
  "role": "MECHANIC",
  "customerId": "{{customerId}}"
}

###
# Recepcionista cadastra staff — espera 403
POST {{baseUrl}}/auth/users
Authorization: Bearer {{receptionistToken}}
Content-Type: application/json

{
  "email": "outro.mecanico@oficina.com",
  "password": "senha123",
  "role": "MECHANIC"
}
