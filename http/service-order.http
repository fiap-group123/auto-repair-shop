@baseUrl = http://localhost:8080

# Fluxo linear da OS (Civic ABC-1234 do John Doe). Rode de cima para baixo, sem pular.
# Anterior: http/inventory.http (Filtro premium + Oleo 5W30). Depois: http/extra-service.http
# (nova OS no mesmo Civic, ja entregue). Rotas reais: /diagnosis/finish e /finish (nao /complete).
# Peca so entra com OS em RECEIVED, IN_DIAGNOSIS ou WAITING_APPROVAL.

###
# 1. Login — gerente
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "gerente@oficina.com",
  "password": "senha123"
}

> {%
client.global.set("managerToken", response.body.accessToken);
client.global.set("managerRefresh", response.body.refreshToken);
%}

###
# 2. Carregar John Doe
GET {{baseUrl}}/customers/document/52998224725
Authorization: Bearer {{managerToken}}

> {%
client.global.set("customerId", response.body.id);
client.global.set("document", response.body.documentId);
%}

###
# 3. Carregar Civic (veiculo da OS)
GET {{baseUrl}}/vehicles?plate=ABC-1234
Authorization: Bearer {{managerToken}}

> {%
client.global.set("osVehicleId", response.body.id);
client.global.set("osVehiclePlate", response.body.plate);
%}

###
# 4. Abrir OS
POST {{baseUrl}}/service-orders
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{
  "document": "{{document}}",
  "vehiclePlate": "{{osVehiclePlate}}"
}

> {% client.global.set("serviceOrderId", response.body.id); %}

###
# 5. Listar todas as OS
GET {{baseUrl}}/service-orders
Authorization: Bearer {{managerToken}}

###
# 6. Incluir servico (permanece na OS)
POST {{baseUrl}}/services
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{
  "serviceOrderId": "{{serviceOrderId}}",
  "name": "Troca de oleo",
  "basePrice": 150.00
}

> {% client.global.set("serviceId", response.body.id); %}

###
# 7. Buscar servico por id
GET {{baseUrl}}/services/{{serviceId}}
Authorization: Bearer {{managerToken}}

###
# 8. Atualizar preco do servico
PUT {{baseUrl}}/services/{{serviceId}}
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{
  "name": "Troca de oleo e filtro",
  "price": 180.00
}

###
# 9. Incluir peca do catalogo (baixa estoque; unitPrice snapshot 52.00)
POST {{baseUrl}}/parts
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{
  "serviceOrderId": "{{serviceOrderId}}",
  "inventoryId": "{{inventoryId}}",
  "quantity": 2
}

> {% client.global.set("partId", response.body.id); %}

###
# 10. Listar pecas da OS
GET {{baseUrl}}/parts/service-order/{{serviceOrderId}}
Authorization: Bearer {{managerToken}}

###
# 11. Buscar peca por id
GET {{baseUrl}}/parts/{{partId}}
Authorization: Bearer {{managerToken}}

###
# 12. Alterar quantidade (delta no estoque)
PUT {{baseUrl}}/parts/{{partId}}
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{
  "quantity": 3
}

###
# 13. Incluir insumo so para remover
POST {{baseUrl}}/parts
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{
  "serviceOrderId": "{{serviceOrderId}}",
  "inventoryId": "{{supplyId}}",
  "quantity": 1
}

> {% client.global.set("throwawayPartId", response.body.id); %}

###
# 14. Remover peca (devolve estoque)
DELETE {{baseUrl}}/parts/{{throwawayPartId}}
Authorization: Bearer {{managerToken}}

###
# 15. Incluir servico extra so para remover
POST {{baseUrl}}/services
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{
  "serviceOrderId": "{{serviceOrderId}}",
  "name": "Alinhamento",
  "basePrice": 80.00
}

> {% client.global.set("throwawayServiceId", response.body.id); %}

###
# 16. Remover servico ainda WAITING
DELETE {{baseUrl}}/services/{{throwawayServiceId}}
Authorization: Bearer {{managerToken}}

###
# 17. Listar servicos
GET {{baseUrl}}/services
Authorization: Bearer {{managerToken}}

###
# 18. Servicos da OS
GET {{baseUrl}}/services/service-order/{{serviceOrderId}}
Authorization: Bearer {{managerToken}}

###
# 19. Servicos do cliente
GET {{baseUrl}}/services/customer/{{customerId}}
Authorization: Bearer {{managerToken}}

###
# 20. Listar OS do cliente
GET {{baseUrl}}/service-orders/customer/{{customerId}}
Authorization: Bearer {{managerToken}}

###
# 21. Consultar OS (serviceIds + partIds)
GET {{baseUrl}}/service-orders/{{serviceOrderId}}
Authorization: Bearer {{managerToken}}

###
# 22. Iniciar diagnostico (cria o orcamento: 180 + 3*52)
POST {{baseUrl}}/service-orders/{{serviceOrderId}}/diagnosis
Authorization: Bearer {{managerToken}}

###
# 23. Encerrar diagnostico (WAITING_APPROVAL)
POST {{baseUrl}}/service-orders/{{serviceOrderId}}/diagnosis/finish
Authorization: Bearer {{managerToken}}

###
# 24. Consultar orcamento
GET {{baseUrl}}/budgets/{{serviceOrderId}}
Authorization: Bearer {{managerToken}}

###
# 25. Aprovar orcamento (BUDGET_APPROVED)
POST {{baseUrl}}/budgets/{{serviceOrderId}}/approve
Authorization: Bearer {{managerToken}}

###
# 26. Iniciar execucao
POST {{baseUrl}}/service-orders/{{serviceOrderId}}/execution
Authorization: Bearer {{managerToken}}

###
# 27. Iniciar o servico
POST {{baseUrl}}/services/{{serviceId}}/in-progress
Authorization: Bearer {{managerToken}}

###
# 28. Finalizar o servico
POST {{baseUrl}}/services/{{serviceId}}/finish
Authorization: Bearer {{managerToken}}

###
# 29. Tempo medio de execucao
GET {{baseUrl}}/services/average-execution-time
Authorization: Bearer {{managerToken}}

###
# 30. Concluir execucao da OS
POST {{baseUrl}}/service-orders/{{serviceOrderId}}/finish
Authorization: Bearer {{managerToken}}

###
# 31. Entregar veiculo
POST {{baseUrl}}/service-orders/{{serviceOrderId}}/deliver
Authorization: Bearer {{managerToken}}
