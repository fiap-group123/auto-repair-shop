@baseUrl = http://localhost:8080

###
# Cadastro — cliente A (CPF)
POST {{baseUrl}}/customers
Content-Type: application/json

{
  "documentId": "529.982.247-25",
  "name": "Ana Souza",
  "email": "ana.souza@email.com",
  "phone": "11987654321"
}

> {% client.global.set("customerId", response.body.id); %}

###
# Cadastro — cliente B (para transferência de veículo)
POST {{baseUrl}}/customers
Content-Type: application/json

{
  "documentId": "111.444.777-35",
  "name": "Bruno Lima",
  "email": "bruno.lima@email.com",
  "phone": "21987654321"
}

> {% client.global.set("newOwnerId", response.body.id); %}

###
# Listar clientes
GET {{baseUrl}}/customers

###
# Buscar por CPF/CNPJ (fluxo da OS)
GET {{baseUrl}}/customers/document/52998224725

###
# Buscar por id
GET {{baseUrl}}/customers/{{customerId}}

###
# Atualizar só o nome
PUT {{baseUrl}}/customers/{{customerId}}
Content-Type: application/json

{
  "name": "Ana Souza Silva"
}

###
# Atualizar e-mail e telefone
PUT {{baseUrl}}/customers/{{customerId}}
Content-Type: application/json

{
  "email": "ana.silva@email.com",
  "phone": "11988887777"
}

###
# Cadastrar veículo do cliente A (Mercosul)
POST {{baseUrl}}/vehicles
Content-Type: application/json

{
  "ownerId": "{{customerId}}",
  "plate": "ABC1D23",
  "brand": "Toyota",
  "model": "Corolla",
  "year": 2024,
  "color": "Prata"
}

> {% client.global.set("vehicleId", response.body.id); %}

###
# Cadastrar segundo veículo (placa antiga)
POST {{baseUrl}}/vehicles
Content-Type: application/json

{
  "ownerId": "{{customerId}}",
  "plate": "ABC-1234",
  "brand": "Honda",
  "model": "Civic",
  "year": 2018,
  "color": "Preto"
}

###
# Listar veículos do cliente A
GET {{baseUrl}}/vehicles/owner/{{customerId}}

###
# Buscar veículo por id
GET {{baseUrl}}/vehicles/{{vehicleId}}

###
# Buscar veículo por placa
GET {{baseUrl}}/vehicles?plate=ABC1D23

###
# Atualizar só o modelo
PUT {{baseUrl}}/vehicles/{{vehicleId}}
Content-Type: application/json

{
  "model": "Corolla Cross"
}

###
# Atualizar marca e ano
PUT {{baseUrl}}/vehicles/{{vehicleId}}
Content-Type: application/json

{
  "brand": "Toyota",
  "year": 2025
}

###
# Atualizar só a placa
PUT {{baseUrl}}/vehicles/{{vehicleId}}
Content-Type: application/json

{
  "plate": "XYZ1A23"
}

###
# Alterar placa
PATCH {{baseUrl}}/vehicles/{{vehicleId}}/plate
Content-Type: application/json

{
  "plate": "XYZ1A23"
}

###
# Transferir veículo para o cliente B
PATCH {{baseUrl}}/vehicles/{{vehicleId}}/owner
Content-Type: application/json

{
  "newOwnerId": "{{newOwnerId}}"
}

###
# CPF duplicado — espera 409
POST {{baseUrl}}/customers
Content-Type: application/json

{
  "documentId": "529.982.247-25",
  "name": "Ana Clone",
  "email": "clone@email.com",
  "phone": "11999999999"
}

###
# Documento inválido — espera 422
POST {{baseUrl}}/customers
Content-Type: application/json

{
  "documentId": "111.111.111-11",
  "name": "Invalido",
  "email": "invalido@email.com",
  "phone": "11999999999"
}

###
# Placa inválida — espera 422
POST {{baseUrl}}/vehicles
Content-Type: application/json

{
  "ownerId": "{{customerId}}",
  "plate": "XXXX",
  "brand": "Fiat",
  "model": "Uno",
  "year": 2010
}

###
# Placa duplicada — espera 409
POST {{baseUrl}}/vehicles
Content-Type: application/json

{
  "ownerId": "{{customerId}}",
  "plate": "ABC-1234",
  "brand": "VW",
  "model": "Gol",
  "year": 2015
}

###
# Desativar cliente A — espera 204
DELETE {{baseUrl}}/customers/{{customerId}}

###
# Cadastrar veículo em cliente inativo — espera 422
POST {{baseUrl}}/vehicles
Content-Type: application/json

{
  "ownerId": "{{customerId}}",
  "plate": "DEF2B34",
  "brand": "Ford",
  "model": "Ka",
  "year": 2019
}
