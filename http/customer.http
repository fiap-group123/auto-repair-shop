@baseUrl = http://localhost:8080

# Fluxo linear de cliente e veiculo. Rode de cima para baixo.
# Anterior: http/auth.http (gerente ja cadastrado). Proximo: http/service-order.http
# Civic ABC-1234 fica com a Ana para a OS. Corolla e usado so neste arquivo (placa/transferencia).

###
# 1. Login — gerente
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "gerente@oficina.com",
  "password": "senha123"
}

> {%
client.global.set("managerToken", response.body.accessToken);
client.global.set("managerRefresh", response.body.refreshToken);
%}

###
# 2. Cadastro — cliente A (Ana)
POST {{baseUrl}}/customers
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{
  "documentId": "529.982.247-25",
  "name": "Ana Souza",
  "email": "ana.souza@email.com",
  "phone": "11987654321"
}

###
# 3. Carregar Ana
GET {{baseUrl}}/customers/document/52998224725
Authorization: Bearer {{managerToken}}

> {%
client.global.set("customerId", response.body.id);
client.global.set("document", response.body.documentId);
%}

###
# 4. Cadastro — cliente B (Bruno, transferencia)
POST {{baseUrl}}/customers
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{
  "documentId": "111.444.777-35",
  "name": "Bruno Lima",
  "email": "bruno.lima@email.com",
  "phone": "21987654321"
}

###
# 5. Carregar Bruno
GET {{baseUrl}}/customers/document/11144477735
Authorization: Bearer {{managerToken}}

> {% client.global.set("newOwnerId", response.body.id); %}

###
# 6. Listar clientes
GET {{baseUrl}}/customers
Authorization: Bearer {{managerToken}}

###
# 7. Buscar Ana por id
GET {{baseUrl}}/customers/{{customerId}}
Authorization: Bearer {{managerToken}}

###
# 8. Atualizar nome
PUT {{baseUrl}}/customers/{{customerId}}
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{
  "name": "Ana Souza Silva"
}

###
# 9. Atualizar e-mail e telefone
PUT {{baseUrl}}/customers/{{customerId}}
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{
  "email": "ana.silva@email.com",
  "phone": "11988887777"
}

###
# 10. Cadastrar Corolla (Mercosul) — demo de placa/transferencia
POST {{baseUrl}}/vehicles
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{
  "ownerId": "{{customerId}}",
  "plate": "ABC1D23",
  "brand": "Toyota",
  "model": "Corolla",
  "year": 2024,
  "color": "Prata"
}

###
# 11. Carregar Corolla pela placa atual (ABC1D23 nesta execucao; XYZ1A23 se ja tiver sido trocada)
GET {{baseUrl}}/vehicles?plate=ABC1D23
Authorization: Bearer {{managerToken}}

> {%
if (response.body && response.body.id) {
  client.global.set("vehicleId", response.body.id);
  client.global.set("vehiclePlate", response.body.plate);
}
%}

###
# 12. Cadastrar Civic (placa antiga) — veiculo da OS, nao mexe mais
POST {{baseUrl}}/vehicles
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{
  "ownerId": "{{customerId}}",
  "plate": "ABC-1234",
  "brand": "Honda",
  "model": "Civic",
  "year": 2018,
  "color": "Preto"
}

###
# 13. Carregar Civic
GET {{baseUrl}}/vehicles?plate=ABC-1234
Authorization: Bearer {{managerToken}}

> {%
if (response.body && response.body.id) {
  client.global.set("osVehicleId", response.body.id);
  client.global.set("osVehiclePlate", response.body.plate);
}
%}

###
# 14. Listar veiculos da Ana
GET {{baseUrl}}/vehicles/owner/{{customerId}}
Authorization: Bearer {{managerToken}}

###
# 15. Buscar Corolla por id
GET {{baseUrl}}/vehicles/{{vehicleId}}
Authorization: Bearer {{managerToken}}

###
# 16. Atualizar modelo do Corolla
PUT {{baseUrl}}/vehicles/{{vehicleId}}
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{
  "model": "Corolla Cross"
}

###
# 17. Atualizar marca, ano e cor
PUT {{baseUrl}}/vehicles/{{vehicleId}}
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{
  "brand": "Toyota",
  "year": 2025,
  "color": "Branco"
}

###
# 18. Trocar placa do Corolla
PATCH {{baseUrl}}/vehicles/{{vehicleId}}/plate
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{
  "plate": "XYZ1A23"
}

> {%
if (response.body && response.body.plate) {
  client.global.set("vehiclePlate", response.body.plate);
}
%}

###
# 19. Buscar Corolla pela placa nova
GET {{baseUrl}}/vehicles?plate=XYZ1A23
Authorization: Bearer {{managerToken}}

> {%
if (response.body && response.body.id) {
  client.global.set("vehicleId", response.body.id);
  client.global.set("vehiclePlate", response.body.plate);
}
%}

###
# 20. Transferir Corolla para o Bruno
PATCH {{baseUrl}}/vehicles/{{vehicleId}}/owner
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{
  "newOwnerId": "{{newOwnerId}}"
}

###
# 21. Devolver Corolla para a Ana
PATCH {{baseUrl}}/vehicles/{{vehicleId}}/owner
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{
  "newOwnerId": "{{customerId}}"
}

###
# 22. Desativar Corolla — espera 204
DELETE {{baseUrl}}/vehicles/{{vehicleId}}
Authorization: Bearer {{managerToken}}

###
# 23. Reativar Corolla — espera 204
POST {{baseUrl}}/vehicles/{{vehicleId}}
Authorization: Bearer {{managerToken}}

###
# --- Erros ---

###
# CPF duplicado — espera 409
POST {{baseUrl}}/customers
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{
  "documentId": "529.982.247-25",
  "name": "Ana Clone",
  "email": "clone@email.com",
  "phone": "11999999999"
}

###
# Documento invalido — espera 422
POST {{baseUrl}}/customers
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{
  "documentId": "111.111.111-11",
  "name": "Invalido",
  "email": "invalido@email.com",
  "phone": "11999999999"
}

###
# Placa invalida — espera 422
POST {{baseUrl}}/vehicles
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{
  "ownerId": "{{customerId}}",
  "plate": "XXXX",
  "brand": "Fiat",
  "model": "Uno",
  "year": 2010,
  "color": "Branco"
}

###
# Placa duplicada (Civic) — espera 409
POST {{baseUrl}}/vehicles
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{
  "ownerId": "{{customerId}}",
  "plate": "ABC-1234",
  "brand": "VW",
  "model": "Gol",
  "year": 2015,
  "color": "Prata"
}

###
# Desativar Ana — espera 204
DELETE {{baseUrl}}/customers/{{customerId}}
Authorization: Bearer {{managerToken}}

###
# Cadastrar veiculo em cliente inativo — espera 422
POST {{baseUrl}}/vehicles
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{
  "ownerId": "{{customerId}}",
  "plate": "DEF2B34",
  "brand": "Ford",
  "model": "Ka",
  "year": 2019,
  "color": "Vermelho"
}

###
# Reativar Ana — espera 204
POST {{baseUrl}}/customers/{{customerId}}
Authorization: Bearer {{managerToken}}
